# ─── TMDB (The Movie Database) ─────────────────────────────────────────────────────────────────────────────────
# Provide ONE of the following to enable live movie data.
# Without these, the app runs on a built-in fallback catalogue.
#
# Option A: Bearer token (v4 API read-access token)
VITE_TMDB_ACCESS_TOKEN=

# Option B: API key (v3)
VITE_TMDB_API_KEY=

# ─── Stripe (Payment Processing) ───────────────────────────────────────────────────────────────────────
# Your Stripe publishable key (safe to expose to the browser).
# Get it from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# ─── Backend API URL ──────────────────────────────────────────────────────────────────────────────────
# Default: http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# Copy this file to .env.local and fill in your values.
